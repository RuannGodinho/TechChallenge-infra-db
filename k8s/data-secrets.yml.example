# Fill through GitHub Actions secrets; do not commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: billing-db-secrets
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_IN_GITHUB_SECRETS
---
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-secrets
type: Opaque
stringData:
  RABBITMQ_USER: REPLACE_IN_GITHUB_SECRETS
  RABBITMQ_PASSWORD: REPLACE_IN_GITHUB_SECRETS
  RABBITMQ_VHOST: oficina
